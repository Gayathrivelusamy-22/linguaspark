rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'energy', 'sparkPoints', 'streak']) &&
        request.resource.data.energy is int &&
        request.resource.data.sparkPoints is int &&
        request.resource.data.streak is int;
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['energy', 'sparkPoints', 'streak', 'lastActive', 'onboardingComplete', 'learningGoal', 'currentLevel']);
    }

    // Progress Tracking
    match /users/{userId}/progress/{worldId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(worldId);
    }

    // AI Chat History
    match /users/{userId}/chats/{chatId} {
      allow read, write: if isOwner(userId) && isValidId(chatId);
    }
  }
}
